    model_config['Tau2'] = [2.1, 3.1, 5.1]
    model_config['Tau3'] = [2., 3., 5.]
    model_config['Tau4'] = [1.9, 2.9, 4.9]
    model_config['Tau5'] = [1.8, 2.8, 4.8]
