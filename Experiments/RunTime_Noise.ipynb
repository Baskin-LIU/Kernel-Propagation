    "    torch.cuda.synchronize()\n",
    "    elapsed_ms = start_event.elapsed_time(end_event)\n",
    "    time_record.append(elapsed_ms)\n",
    "    print(f\"GPU time: {elapsed_ms / 1000:.4f} seconds\")\n",
    "\n",
    "print('finished')"
   ]
